{
  "info": {
    "name": "Online Menu API",
    "description": "All endpoints of the Online Menu API (Part 1).\n\nRun the whole collection top-to-bottom (Collection Runner): requests save `branchId` and `menuItemId` into collection variables, so the next requests use them.\n\nFor 'Upload image' select a file in Body → form-data first (or skip that folder in the Runner).\n\nChange `baseUrl` if the API runs on another port.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Branches",
      "item": [
        {
          "name": "Create branch",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/branches",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "branches"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Esentai\",\n  \"slug\": \"esentai-{{$timestamp}}\",\n  \"address\": \"Al-Farabi Ave 77, Almaty\",\n  \"phone\": \"+7 700 000 00 03\",\n  \"active\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test(\"Has id\", () => pm.expect(b.id).to.be.a(\"number\"));",
                  "pm.collectionVariables.set(\"branchId\", b.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List branches",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/branches",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "branches"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Is array\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get branch by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/branches/{{branchId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "branches",
                "{{branchId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Same id\", () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"branchId\"))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update branch",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/branches/{{branchId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "branches",
                "{{branchId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Esentai Mall\",\n  \"slug\": \"esentai-mall-{{$timestamp}}\",\n  \"address\": \"Al-Farabi Ave 77/8, Almaty\",\n  \"phone\": \"+7 700 000 00 04\",\n  \"active\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Name updated\", () => pm.expect(pm.response.json().name).to.eql(\"Esentai Mall\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Menu items",
      "item": [
        {
          "name": "Create menu item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/menu-items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "menu-items"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"branchId\": {{branchId}},\n  \"name\": \"Cheeseburger\",\n  \"description\": \"Beef patty, double cheddar\",\n  \"category\": \"Burgers\",\n  \"price\": 2490.0,\n  \"available\": true,\n  \"sortOrder\": 30\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const m = pm.response.json();",
                  "pm.collectionVariables.set(\"menuItemId\", m.id);",
                  "pm.test(\"No image yet\", () => pm.expect(m.imageUrl).to.eql(null));"
                ]
              }
            }
          ]
        },
        {
          "name": "List menu items",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/menu-items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "menu-items"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "List menu items of branch (filters)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/menu-items?branchId={{branchId}}&category=Burgers&available=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "menu-items"
              ],
              "query": [
                {
                  "key": "branchId",
                  "value": "{{branchId}}"
                },
                {
                  "key": "category",
                  "value": "Burgers"
                },
                {
                  "key": "available",
                  "value": "true"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"All from branch\", () => pm.response.json().forEach(i => pm.expect(i.branchId).to.eql(Number(pm.collectionVariables.get(\"branchId\")))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get menu item by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/menu-items/{{menuItemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "menu-items",
                "{{menuItemId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update menu item",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/menu-items/{{menuItemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "menu-items",
                "{{menuItemId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"branchId\": {{branchId}},\n  \"name\": \"Double Cheeseburger\",\n  \"description\": \"Two beef patties, double cheddar\",\n  \"category\": \"Burgers\",\n  \"price\": 3290.0,\n  \"available\": false,\n  \"sortOrder\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Price updated\", () => pm.expect(pm.response.json().price).to.eql(3290));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Menu item image",
      "description": "Before running 'Upload image', select an image file in Body → form-data → file.",
      "item": [
        {
          "name": "Upload image",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/menu-items/{{menuItemId}}/image",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "menu-items",
                "{{menuItemId}}",
                "image"
              ]
            },
            "description": "Body → form-data → key `file` (type File). Choose any .jpg/.png/.webp up to 5 MB.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Select a .jpg/.png/.webp image"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"imageUrl set\", () => pm.expect(pm.response.json().imageUrl).to.include(\"/image\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get image",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/menu-items/{{menuItemId}}/image",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "menu-items",
                "{{menuItemId}}",
                "image"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Is image\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.match(/^image\\//));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete image",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/menu-items/{{menuItemId}}/image",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "menu-items",
                "{{menuItemId}}",
                "image"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
