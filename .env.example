# Copy to .env and adjust:  cp .env.example .env

# --- Database (PostgreSQL) ---
POSTGRES_DB=online_menu
POSTGRES_USER=menu
POSTGRES_PASSWORD=change-me
# Port on the host machine to connect to Postgres with a DB client
DB_EXTERNAL_PORT=5433

# --- API ---
# Port on the host machine where the API is available
API_PORT=8080
UPLOAD_MAX_FILE_SIZE=5MB
JAVA_OPTS=-XX:MaxRAMPercentage=75
